# EditorConfig — https://editorconfig.org
# Top-most file; stops the search here.
root = true

############################
# All files
############################
[*]
# charset intentionally unset: VS saves C# with a UTF-8 BOM, and forcing a
# charset makes `dotnet format` try to change it (which MSBuildWorkspace rejects).
indent_style = space
indent_size = 4
end_of_line = crlf
trim_trailing_whitespace = true
insert_final_newline = true

############################
# Markup / config / data files use 2-space indent
############################
[*.{csproj,props,targets,json,yml,yaml,config,xml}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false   # trailing spaces can be meaningful in Markdown

############################
# C# files
############################
[*.cs]

# --- Usings ---
csharp_using_directive_placement = outside_namespace:warning
dotnet_sort_system_directives_first = true
dotnet_separate_import_directive_groups = false
dotnet_diagnostic.IDE0005.severity = warning   # remove unnecessary usings

# --- namespaces / braces ---
csharp_style_namespace_declarations = block_scoped:suggestion
csharp_prefer_braces = true:suggestion
csharp_new_line_before_open_brace = all

# --- var usage (be explicit on the right, var when the type is obvious) ---
csharp_style_var_for_built_in_types = false:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion

# --- expression-bodied members ---
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
csharp_style_expression_bodied_accessors = true:suggestion

# --- modern language features ---
csharp_prefer_simple_using_statement = true:suggestion
csharp_style_prefer_primary_constructors = false:suggestion
csharp_style_inlined_variable_declaration = true:suggestion
dotnet_style_prefer_conditional_expression_over_assignment = true:suggestion
dotnet_style_null_propagation = true:suggestion
dotnet_style_coalesce_expression = true:suggestion
dotnet_style_prefer_is_null_check_over_reference_equality_method = true:suggestion

# --- 'this.' is not required ---
dotnet_style_qualification_for_field = false:suggestion
dotnet_style_qualification_for_property = false:suggestion
dotnet_style_qualification_for_method = false:suggestion

# --- accessibility modifiers always explicit ---
dotnet_style_require_accessibility_modifiers = for_non_interface_members:warning
dotnet_style_readonly_field = true:suggestion

############################
# Naming conventions
############################

# Interfaces: IPascalCase
dotnet_naming_rule.interfaces_start_with_i.severity = warning
dotnet_naming_rule.interfaces_start_with_i.symbols = interface_symbol
dotnet_naming_rule.interfaces_start_with_i.style = prefix_i_pascal
dotnet_naming_symbols.interface_symbol.applicable_kinds = interface
dotnet_naming_style.prefix_i_pascal.capitalization = pascal_case
dotnet_naming_style.prefix_i_pascal.required_prefix = I

# Types & public members: PascalCase
dotnet_naming_rule.types_pascal.severity = suggestion
dotnet_naming_rule.types_pascal.symbols = type_and_member_symbol
dotnet_naming_rule.types_pascal.style = pascal
dotnet_naming_symbols.type_and_member_symbol.applicable_kinds = class, struct, enum, property, method, event
dotnet_naming_symbols.type_and_member_symbol.applicable_accessibilities = public, internal, protected
dotnet_naming_style.pascal.capitalization = pascal_case

# Private fields: _camelCase
dotnet_naming_rule.private_fields_underscore.severity = suggestion
dotnet_naming_rule.private_fields_underscore.symbols = private_field_symbol
dotnet_naming_rule.private_fields_underscore.style = underscore_camel
dotnet_naming_symbols.private_field_symbol.applicable_kinds = field
dotnet_naming_symbols.private_field_symbol.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

############################
# Generated / migration code — relax
############################
[*.{Designer,g,g.i}.cs]
dotnet_diagnostic.IDE0005.severity = none

[**/Migrations/*.cs]
dotnet_diagnostic.IDE0005.severity = none

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDB": {
    "DatabaseName": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "serverUrl": "http://localhost:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "Queue": {
    "QueueName": "notifications"
  },
  "Email": {
    "InternalAddressEmail": "panamvalves@gmail.com"
  },
  "ReverseProxy": {
    "Routes": {
      "fallback-to-old": {
        "ClusterId": "old-backend",
        "Match": { "Path": "{**catch-all}" }
      }
    },
    "Clusters": {
      "old-backend": {
        "Destinations": {
          "d1": { "Address": "https://valvenok-api-container.mangobeach-29eb5614.ukwest.azurecontainerapps.io/" }
        }
      }
    }
  }
}
